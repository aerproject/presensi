#--------------------------------------------------------------------
# PRESENSI DIGITAL
# BY AERPROJECT
# Environment Configuration Template
#--------------------------------------------------------------------

CI_ENVIRONMENT = production


#--------------------------------------------------------------------
# APPLICATION
#--------------------------------------------------------------------

app.baseURL = 'https://your-domain.example/'
app.indexPage = ''
app.forceGlobalSecureRequests = false


#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = YOUR_DATABASE_NAME
database.default.username = YOUR_DATABASE_USER
database.default.password = YOUR_DATABASE_PASSWORD
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306


#--------------------------------------------------------------------
# SECURITY
#--------------------------------------------------------------------

encryption.key = YOUR_ENCRYPTION_KEY


#--------------------------------------------------------------------
# LICENSE
#--------------------------------------------------------------------

LICENSE_BASE_URL = https://lisensi.aerproject.id
LICENSE_APP_CODE = PRESENSI
LICENSE_APP_VERSION = 1.0.0
LICENSE_TIMEOUT = 15

# Runtime credentials.
# Automatically generated during Trial / Full License process.
LICENSE_API_KEY =
LICENSE_API_SECRET =

# Local license secret.
LICENSE_SECRET =


#--------------------------------------------------------------------
# EMAIL
#--------------------------------------------------------------------

email.fromEmail = YOUR_EMAIL_ADDRESS
email.fromName = 'PRESENSI AER'


#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.driver = CodeIgniter\Session\Handlers\FileHandler


#--------------------------------------------------------------------
# CACHE
#--------------------------------------------------------------------

cache.handler = file
cache.backupHandler = dummy
cache.prefix =
